  "cards": [
    {
      "dot": "emerald",
      "title": "Un login para los dos roles",
      "items": [
        "La diferencia vive en los claims: role, y profesionalId solo para el profesional",
        "El cliente nunca manda su profesionalId — sale del token firmado por el servidor"
      ]
    },
    {
      "dot": "rose",
      "title": "Dos tokens, dos vidas",
      "items": [
        "Access token JWT HS256 de ~15 min, guardado solo en memoria del cliente",
        "Refresh opaco de ~14 días en cookie httpOnly, guardado hasheado SHA-256 en la base"
      ]
    },
    {
      "dot": "slate",
      "title": "Defensas del login",
      "items": [
        "Rate limit de 5 intentos por IP cada 60s: el sexto responde 429",
        "Passwords con BCrypt; el hash nunca sale de Infrastructure"
      ]
    }
